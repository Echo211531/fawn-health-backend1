<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ljh.fawnhealth.mapper.CartMapper">

    <resultMap id="BaseResultMap" type="com.ljh.fawnhealth.model.entity.Cart">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="productId" column="product_id" jdbcType="BIGINT"/>
            <result property="quantity" column="quantity" jdbcType="INTEGER"/>
            <result property="selected" column="selected" jdbcType="TINYINT"/>
            <result property="specs" column="specs" jdbcType="OTHER"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="isDelete" column="is_delete" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,product_id,
        quantity,selected,specs,
        create_time,update_time,is_delete
    </sql>
    <!-- 根据用户ID和商品ID查询购物车记录 -->
    <select id="selectByUserIdAndProductId" resultType="com.ljh.fawnhealth.model.entity.Cart">
        SELECT id, user_id, product_id, quantity, selected,
               specs, create_time, update_time, is_delete
        FROM cart
        WHERE user_id = #{userId}
          AND product_id = #{productId}
          AND is_delete = 0
    </select>
</mapper>
